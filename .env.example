# Copy this file to .env and fill in your machine's actual values.
# .env is gitignored; this file is committed as a template.

# Filesystem paths (optional — default to relative folders under the repo root if unset)
# KOD_DIR=
# FRAMES_DIR=
# VIDEO_OUTPUT_PATH=
# JSON_OUTPUT_PATH=

# Absolute paths to your local GGUF model files
MODEL_PATH=/path/to/your/model.gguf
MMPROJ_PATH=/path/to/your/mmproj.gguf

# ffmpeg binary. Leave as "ffmpeg" if it's on PATH, or set an absolute path
# if your shell session's PATH doesn't pick it up yet (e.g. right after a
# fresh install, before restarting your terminal/IDE).
FFMPEG_BINARY=ffmpeg

# llama-server
LLAMA_SERVER_URL=http://127.0.0.1:8080/v1/chat/completions
REQUEST_TIMEOUT=120
AGGREGATOR_REQUEST_TIMEOUT=90

# Model / generation
MODEL_NAME=qwen3vl
TEMPERATURE=0.1
VISION_MAX_TOKENS=1500
AGGREGATOR_MAX_TOKENS=1200

# Frame sampling defaults
DEFAULT_FPS=2
DEFAULT_CHUNK_SIZE=10
MAX_REACT_ITERATIONS=5
